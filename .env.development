# Backend defaults to PORT=3001 (see bonjack-tools-backend-go/.env.example).
PUBLIC_WEBSOCKET_ENDPOINT="ws://localhost:3001/ws"
PUBLIC_HTTP_ENDPOINT="http://localhost:3001/api"
PUBLIC_AUTH0_DOMAIN=
PUBLIC_AUTH0_AUDIENCE=
PUBLIC_AUTH0_CLIENT_ID=
# Auth0 unset: the app acts as this identity against a backend without JWT
# (go run ./cmd/swissdev). Switch at runtime from the Swiss pages or with
# localStorage.setItem("devSubject", "someone-else").
PUBLIC_DEV_SUBJECT=dev
PUBLIC_SPOTIFY_CLIENT_ID=
